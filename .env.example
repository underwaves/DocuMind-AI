# DocuMind AI Configuration
PROJECT_NAME="DocuMind AI"
API_V1_STR="/api/v1"
SECRET_KEY="documind-super-secret-jwt-key-2026-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL with pgvector)
# When running with Docker Compose:
DATABASE_URL="postgresql://documind:documind_secret@localhost:5432/documind_db"

# Fallback mode: If PostgreSQL is not reachable, seamlessly use local SQLite vector store
USE_SQLITE_FALLBACK=True

# Google Gemini API Key
# Sign up and get free key at https://aistudio.google.com/
GEMINI_API_KEY=""

# Model Configurations
EMBEDDING_MODEL="gemini-embedding-001"
CHAT_MODEL="gemini-3.5-flash-lite"

# RAG Ingestion & Retrieval Settings
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RETRIEVAL=4
SIMILARITY_THRESHOLD=0.35
